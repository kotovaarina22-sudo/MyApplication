<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical"
    tools:context=".detail.DogDetailActivity">

    <!-- Прокручиваемая часть + кнопки «назад» и «избранное» поверх неё -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Галерея фото с точками -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="380dp">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/photoPager"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:background="@drawable/bg_top_shade" />

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/photoDots"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="40dp"
                        android:background="@android:color/transparent"
                        app:tabBackground="@drawable/dot_selector"
                        app:tabGravity="center"
                        app:tabIndicatorHeight="0dp"
                        app:tabMaxWidth="20dp"
                        app:tabMinWidth="20dp"
                        app:tabRippleColor="@null" />
                </FrameLayout>

                <!-- Белая «шторка» с информацией, заезжает на фото -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-28dp"
                    android:background="@drawable/bg_sheet"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_main"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        tools:text="Булочка" />

                    <TextView
                        android:id="@+id/breed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/peach_dark"
                        android:textSize="16sp"
                        tools:text="Метис чихуахуа" />

                    <!-- Три плашки: возраст, пол, вес -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <LinearLayout style="@style/InfoBox">

                            <TextView
                                style="@style/InfoBoxLabel"
                                android:text="@string/detail_age" />

                            <TextView
                                android:id="@+id/ageValue"
                                style="@style/InfoBoxValue"
                                tools:text="2 года" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/InfoBox"
                            android:layout_marginHorizontal="8dp">

                            <TextView
                                style="@style/InfoBoxLabel"
                                android:text="@string/detail_gender" />

                            <TextView
                                android:id="@+id/genderValue"
                                style="@style/InfoBoxValue"
                                tools:text="Девочка" />
                        </LinearLayout>

                        <LinearLayout style="@style/InfoBox">

                            <TextView
                                style="@style/InfoBoxLabel"
                                android:text="@string/detail_weight" />

                            <TextView
                                android:id="@+id/weightValue"
                                style="@style/InfoBoxValue"
                                tools:text="2,1 кг" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="@color/text_main"
                        android:textSize="15sp"
                        tools:text="🎨 Окрас: рыжий" />

                    <TextView
                        android:id="@+id/arrival"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_main"
                        android:textSize="15sp"
                        tools:text="🏠 В приюте с 12.01.2026" />

                    <!-- Значки характера и здоровья — создаются в коде -->
                    <TextView
                        style="@style/DetailHeader"
                        android:text="@string/detail_badges" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/badges"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        style="@style/DetailHeader"
                        android:text="@string/detail_story" />

                    <TextView
                        android:id="@+id/story"
                        style="@style/DetailText"
                        tools:text="История собаки" />

                    <TextView
                        style="@style/DetailHeader"
                        android:text="@string/detail_character" />

                    <TextView
                        android:id="@+id/character"
                        style="@style/DetailText"
                        tools:text="Характер собаки" />

                    <!-- Связь с приютом -->
                    <TextView
                        style="@style/DetailHeader"
                        android:text="@string/detail_contact" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/callButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="@string/detail_call"
                            app:icon="@drawable/ic_phone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/telegramButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_telegram"
                            app:icon="@drawable/ic_send" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Кнопки поверх фото -->
        <LinearLayout
            android:id="@+id/topButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                style="@style/RoundIconButton"
                android:contentDescription="@string/detail_back"
                android:src="@drawable/ic_arrow_back" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/favoriteButton"
                style="@style/RoundIconButton"
                android:contentDescription="@string/favorite_button"
                android:src="@drawable/ic_favorite_border" />
        </LinearLayout>
    </FrameLayout>

    <!-- Нижняя панель с главной кнопкой — всегда на экране -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/applyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:paddingVertical="14dp"
            android:text="@string/detail_apply"
            android:textSize="17sp" />
    </LinearLayout>

</LinearLayout>
