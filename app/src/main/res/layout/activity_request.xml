<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical"
    tools:context=".request.RequestActivity">

    <!-- Верхняя панель: «назад» и заголовок -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/backButton"
            style="@style/RoundIconButton"
            android:background="@android:color/transparent"
            android:contentDescription="@string/detail_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/request_title"
            android:textColor="@color/text_main"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Форма -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/formScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="24dp">

                <!-- Выбранная собака -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/dogPhoto"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearance="@style/RoundedPhoto"
                            tools:src="@drawable/dog1_1" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/request_chosen"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/dogName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_main"
                                android:textSize="19sp"
                                android:textStyle="bold"
                                tools:text="Булочка" />

                            <TextView
                                android:id="@+id/dogBreed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/peach_dark"
                                android:textSize="14sp"
                                tools:text="Метис чихуахуа" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Тип заявки: можно выбрать только один вариант -->
                <TextView
                    style="@style/DetailHeader"
                    android:text="@string/request_type" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/typeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:checkedButton="@+id/typeAdopt"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/typeAdopt"
                        style="@style/RequestTypeButton"
                        android:text="@string/type_adopt" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/typeFoster"
                        style="@style/RequestTypeButton"
                        android:text="@string/type_foster" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/typeWalk"
                        style="@style/RequestTypeButton"
                        android:text="@string/type_walk" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Дата прогулки — видна только для «Прийти погулять» -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/dateLayout"
                    style="@style/FormField"
                    android:hint="@string/field_date"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/dateInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Контакты -->
                <TextView
                    style="@style/DetailHeader"
                    android:text="@string/request_contacts" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/nameLayout"
                    style="@style/FormField"
                    android:layout_marginTop="0dp"
                    android:hint="@string/field_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="50" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/phoneLayout"
                    style="@style/FormField"
                    android:hint="@string/field_phone"
                    app:placeholderText="+7 999 123-45-67">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phoneInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailLayout"
                    style="@style/FormField"
                    android:hint="@string/field_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- О доме: выпадающие списки. Для прогулки этот блок скрыт -->
                <LinearLayout
                    android:id="@+id/homeSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/DetailHeader"
                        android:text="@string/request_home" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/housingLayout"
                        style="@style/FormDropdown"
                        android:layout_marginTop="0dp"
                        android:hint="@string/field_housing">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/housingInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            app:simpleItems="@array/housing_options" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/animalsLayout"
                        style="@style/FormDropdown"
                        android:hint="@string/field_animals">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/animalsInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            app:simpleItems="@array/animals_options" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/commentLayout"
                    style="@style/FormField"
                    android:hint="@string/field_comment"
                    app:counterEnabled="true"
                    app:counterMaxLength="500"
                    app:helperText="@string/field_optional">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/commentInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="500"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/consentCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/field_consent"
                    android:textColor="@color/text_main"
                    app:errorAccessibilityLabel="@string/error_consent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submitButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingVertical="14dp"
                    android:text="@string/request_submit"
                    android:textSize="17sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Экран «Спасибо» — показывается после успешной отправки -->
        <LinearLayout
            android:id="@+id/successView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/success_emoji"
                android:textSize="72sp" />

            <TextView
                android:id="@+id/successTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/peach_dark"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="Спасибо, Мария!" />

            <TextView
                android:id="@+id/successText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_main"
                android:textSize="16sp"
                tools:text="Заявка отправлена" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backToCatalogButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:paddingVertical="14dp"
                android:text="@string/success_back"
                android:textSize="17sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
