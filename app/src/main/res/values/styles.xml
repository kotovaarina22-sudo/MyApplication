<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Общий вид вопросов и ответов в анкете, чтобы не повторять атрибуты -->
    <style name="QuizQuestion">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="QuizAnswer">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Форма фото на карточке: все 4 угла скруглены -->
    <style name="RoundedPhoto">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
</resources>
